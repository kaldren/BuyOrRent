@page "{id:guid}"
@model BuyOrRent.Web.Pages.Admin.ReviewListingModel
@{
    ViewData["Title"] = "Преглед на обява";
}

<h1>Преглед на обява</h1>

<div class="row">
    <div class="col-md-8">
        @if (Model.Listing.ImageUrls.Any())
        {
            <div id="reviewCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @for (var i = 0; i < Model.Listing.ImageUrls.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@Model.Listing.ImageUrls[i]" class="d-block w-100 rounded" alt="@Model.Listing.Title" style="max-height: 400px; object-fit: cover;" />
                        </div>
                    }
                </div>
                @if (Model.Listing.ImageUrls.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#reviewCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#reviewCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                }
            </div>
        }

        <h2>@Model.Listing.Title</h2>
        <p class="text-primary fs-3 fw-bold">@(Model.Listing.Price.HasValue ? Model.Listing.Price.Value.ToString("C") : "По договаряне")</p>

        <p class="text-muted">
            @Model.Listing.Address<br />
            @Model.Listing.CityName, @Model.Listing.MunicipalityName, @Model.Listing.RegionName
        </p>

        <hr />

        <div class="row text-center mb-4">
            <div class="col">
                <div class="fs-4 fw-bold">@Model.Listing.NumberOfBedrooms</div>
                <div class="text-muted">Спални</div>
            </div>
            <div class="col">
                <div class="fs-4 fw-bold">@Model.Listing.NumberOfBathrooms</div>
                <div class="text-muted">Бани</div>
            </div>
            <div class="col">
                <div class="fs-4 fw-bold">@Model.Listing.SquareFootage.ToString("N0")</div>
                <div class="text-muted">кв.м.</div>
            </div>
        </div>

        <hr />

        <h5>Описание</h5>
        <p>@Model.Listing.Description</p>

        <hr />

        <dl class="row">
            <dt class="col-sm-3">Статус</dt>
            <dd class="col-sm-9"><span class="badge bg-warning text-dark">Чака преглед</span></dd>

            <dt class="col-sm-3">Създадена</dt>
            <dd class="col-sm-9">@Model.Listing.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
        </dl>
    </div>

    <div class="col-md-4">
        <div class="card border-success mb-3">
            <div class="card-header bg-success text-white">Одобряване</div>
            <div class="card-body">
                <p class="card-text">Одобрете обявата, за да стане видима за всички потребители.</p>
                <form method="post" asp-page-handler="Approve" asp-route-id="@Model.Listing.Id">
                    <button type="submit" class="btn btn-success w-100">Одобри</button>
                </form>
            </div>
        </div>

        <div class="card border-danger">
            <div class="card-header bg-danger text-white">Отхвърляне</div>
            <div class="card-body">
                <p class="card-text">Отхвърлете обявата и посочете причина.</p>
                <form method="post" asp-page-handler="Reject" asp-route-id="@Model.Listing.Id">
                    <div class="mb-3">
                        <label asp-for="RejectionReason" class="form-label"></label>
                        <textarea asp-for="RejectionReason" class="form-control" rows="4" placeholder="Опишете причината за отхвърляне..."></textarea>
                        <span asp-validation-for="RejectionReason" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-danger w-100">Отхвърли</button>
                </form>
            </div>
        </div>

        <div class="mt-3">
            <a asp-page="ReviewQueue" class="btn btn-secondary w-100">Обратно към опашката</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
