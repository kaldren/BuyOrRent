@page
@model BuyOrRent.Web.Pages.Admin.ReviewQueueModel
@{
    ViewData["Title"] = "Обяви за преглед";
}

<h1>Обяви за преглед</h1>

@if (!Model.PendingListings.Any())
{
    <div class="alert alert-success">Няма обяви чакащи преглед.</div>
}
else
{
    <p class="text-muted">@Model.PendingListings.Count обяви чакат преглед.</p>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Заглавие</th>
                <th>Местоположение</th>
                <th>Цена</th>
                <th>Създадена</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var listing in Model.PendingListings)
            {
                <tr>
                    <td><a asp-page="/Listings/Details" asp-route-id="@listing.Id">@listing.Title</a></td>
                    <td>@listing.CityName, @listing.MunicipalityName</td>
                    <td>@(listing.Price.HasValue ? listing.Price.Value.ToString("C") : "По договаряне")</td>
                    <td>@listing.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <a asp-page="ReviewListing" asp-route-id="@listing.Id" class="btn btn-sm btn-outline-primary">Прегледай</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
