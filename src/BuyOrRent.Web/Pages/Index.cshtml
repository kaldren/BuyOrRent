@page
@model IndexModel
@{
    ViewData["Title"] = L["Home_Title"].Value;
}

<div class="hero-section">
    <h1>@L["Home_Welcome"]</h1>
    <p>@L["Home_Subtitle"]</p>
</div>

<div class="card search-card mb-5">
    <div class="card-body">
        <h5 class="section-heading">@L["Home_SearchTitle"]</h5>
        <form method="get" action="/Listings/Search">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">@L["Field_Region"]</label>
                    <select name="RegionId" class="form-select" id="regionSelect">
                        <option value="">@L["Filter_AllRegions"]</option>
                        @foreach (var region in Model.Regions)
                        {
                            <option value="@region.Value">@region.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["Field_Municipality"]</label>
                    <select name="MunicipalityId" class="form-select" id="municipalitySelect" disabled data-placeholder="@L["Filter_AllMunicipalities"]">
                        <option value="">@L["Filter_AllMunicipalities"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["Field_City"]</label>
                    <select name="CityId" class="form-select" id="citySelect" disabled data-placeholder="@L["Filter_AllCities"]">
                        <option value="">@L["Filter_AllCities"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["Field_PropertyType"]</label>
                    <select name="PropertyType" class="form-select">
                        <option value="">@L["Filter_AllTypes"]</option>
                        @foreach (var pt in Model.PropertyTypeOptions)
                        {
                            <option value="@pt.Value">@pt.Text</option>
                        }
                    </select>
                </div>
            </div>
            <div class="mt-3 text-end">
                <button type="submit" class="btn btn-primary btn-lg">
                    @L["Action_Search"]
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.FeaturedListings.Any())
{
    <h2 class="section-heading">@L["Home_FeaturedListings"]</h2>
    <div class="row">
        @foreach (var listing in Model.FeaturedListings)
        {
            <div class="col-md-4 mb-4">
                <a asp-page="/Listings/Details" asp-route-id="@listing.Id" class="text-decoration-none text-reset">
                <div class="card listing-card h-100">
                    @if (listing.ImageUrls.Any())
                    {
                        <img src="@listing.ImageUrls[0]" class="card-img-top" alt="@listing.Title" />
                    }
                    else
                    {
                        <div class="no-image-placeholder">
                            <span>@L["NoImage"]</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@listing.Title</h5>
                        <p class="card-text price">@(listing.Price.HasValue ? listing.Price.Value.ToString("C") : L["Negotiable"].Value)</p>
                        @{
                            Model.Ratings.TryGetValue(listing.Id, out var rating);
                        }
                        <p class="card-text">
                            <span class="stars-filled">
                                @for (var s = 1; s <= 5; s++)
                                {
                                    if (s <= Math.Round(rating.Average))
                                    {
                                        <span>&#9733;</span>
                                    }
                                    else
                                    {
                                        <span class="stars-empty">&#9734;</span>
                                    }
                                }
                            </span>
                            <small class="text-muted">(@rating.Count)</small>
                        </p>
                        <p class="card-text text-muted">@listing.CityName, @listing.MunicipalityName</p>
                        <p class="card-text">
                            <small>@listing.NumberOfBedrooms @L["Unit_Bedrooms"] &middot; @listing.NumberOfBathrooms @L["Unit_Bathrooms"] &middot; @listing.SquareFootage @L["Unit_SqM"]</small>
                        </p>
                    </div>
                </div>
                </a>
            </div>
        }
    </div>
    <div class="text-center mt-2">
        <a asp-page="/Listings/Index" class="btn btn-outline-primary">@L["Home_ViewAll"]</a>
    </div>
}
else
{
    <div class="alert alert-info text-center">@L["Home_NoListings"] <a asp-page="/Listings/Create">@L["Home_CreateOne"]</a>!</div>
}

@section Scripts {
    <partial name="_LocationDropdownScriptsPartial" />
}
