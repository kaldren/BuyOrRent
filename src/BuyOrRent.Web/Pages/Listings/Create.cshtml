@page
@model BuyOrRent.Web.Pages.Listings.CreateModel
@{
    ViewData["Title"] = L["Create_Title"].Value;
}

<h1>@L["Create_Title"]</h1>

<div class="row">
    <div class="col-md-8">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.Title" class="form-label"></label>
                <input asp-for="Input.Title" class="form-control" />
                <span asp-validation-for="Input.Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Description" class="form-label"></label>
                <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Input.Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Price" class="form-label"></label>
                <input asp-for="Input.Price" class="form-control" type="number" step="0.01" min="0" placeholder="@L["PricePlaceholder"]" />
                <span asp-validation-for="Input.Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Images" class="form-label"></label>
                <input asp-for="Images" class="form-control" type="file" accept="image/*" multiple />
            </div>

            <div class="mb-3">
                <label asp-for="Input.Address" class="form-label"></label>
                <input asp-for="Input.Address" class="form-control" />
                <span asp-validation-for="Input.Address" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.RegionId" class="form-label"></label>
                    <select asp-for="Input.RegionId" asp-items="Model.Regions" class="form-select" id="regionSelect">
                        <option value="">@L["Filter_SelectRegion"]</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.MunicipalityId" class="form-label"></label>
                    <select asp-for="Input.MunicipalityId" class="form-select" id="municipalitySelect" disabled data-placeholder="@L["Filter_SelectMunicipality"]">
                        <option value="">@L["Filter_SelectMunicipality"]</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.CityId" class="form-label"></label>
                    <select asp-for="Input.CityId" class="form-select" id="citySelect" disabled data-placeholder="@L["Filter_SelectCity"]">
                        <option value="">@L["Filter_SelectCity"]</option>
                    </select>
                    <span asp-validation-for="Input.CityId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.NumberOfBedrooms" class="form-label"></label>
                    <input asp-for="Input.NumberOfBedrooms" class="form-control" type="number" />
                    <span asp-validation-for="Input.NumberOfBedrooms" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.NumberOfBathrooms" class="form-label"></label>
                    <input asp-for="Input.NumberOfBathrooms" class="form-control" type="number" />
                    <span asp-validation-for="Input.NumberOfBathrooms" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.SquareFootage" class="form-label"></label>
                    <input asp-for="Input.SquareFootage" class="form-control" type="number" step="0.1" />
                    <span asp-validation-for="Input.SquareFootage" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Input.PropertyType" class="form-label"></label>
                <select asp-for="Input.PropertyType" asp-items="Model.PropertyTypeOptions" class="form-select">
                    <option value="">@L["Filter_SelectPropertyType"]</option>
                </select>
                <span asp-validation-for="Input.PropertyType" class="text-danger"></span>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">@L["Action_Create"]</button>
                <a asp-page="Index" class="btn btn-secondary">@L["Action_Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_LocationDropdownScriptsPartial" />
}
