@page "{id:guid}"
@model BuyOrRent.Web.Pages.Listings.DeleteModel
@{
    ViewData["Title"] = L["Delete_Title"].Value;
}

<h1>@L["Delete_Title"]</h1>

<div class="alert alert-danger">
    <h4>@L["Delete_Confirm"]</h4>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@L["Field_Title"]</dt>
            <dd class="col-sm-9">@Model.Listing.Title</dd>

            <dt class="col-sm-3">@L["Field_Address"]</dt>
            <dd class="col-sm-9">@Model.Listing.Address, @Model.Listing.CityName, @Model.Listing.MunicipalityName, @Model.Listing.RegionName</dd>

            <dt class="col-sm-3">@L["Field_Price"]</dt>
            <dd class="col-sm-9">@(Model.Listing.Price.HasValue ? Model.Listing.Price.Value.ToString("C") : L["Negotiable"].Value)</dd>

            <dt class="col-sm-3">@L["Field_Bedrooms"]</dt>
            <dd class="col-sm-9">@Model.Listing.NumberOfBedrooms</dd>

            <dt class="col-sm-3">@L["Field_Bathrooms"]</dt>
            <dd class="col-sm-9">@Model.Listing.NumberOfBathrooms</dd>

            <dt class="col-sm-3">@L["Field_SquareFootage"]</dt>
            <dd class="col-sm-9">@Model.Listing.SquareFootage</dd>
        </dl>
    </div>
</div>

<form method="post" class="mt-3">
    <input type="hidden" name="id" value="@Model.Listing.Id" />
    <button type="submit" class="btn btn-danger">@L["Action_Delete"]</button>
    <a asp-page="Index" class="btn btn-secondary">@L["Action_Cancel"]</a>
</form>
