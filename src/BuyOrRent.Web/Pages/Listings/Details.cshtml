@page "{id:guid}"
@using global::Listings.Listing.Enums
@model BuyOrRent.Web.Pages.Listings.DetailsModel
@{
    ViewData["Title"] = Model.Listing.Title;
}

<div class="row">
    <div class="col-md-8">
        @if (Model.Listing.ImageUrls.Any())
        {
            <div id="listingCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
                <div class="carousel-inner" style="border-radius: .75rem; overflow: hidden;">
                    @for (var i = 0; i < Model.Listing.ImageUrls.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@Model.Listing.ImageUrls[i]" class="d-block w-100" alt="@Model.Listing.Title" style="max-height: 400px; object-fit: cover;" />
                        </div>
                    }
                </div>
                @if (Model.Listing.ImageUrls.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#listingCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#listingCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                }
            </div>
        }

        <h1>@Model.Listing.Title</h1>
        <p class="fs-3 fw-bold" style="color: var(--primary-dark);">@(Model.Listing.Price.HasValue ? Model.Listing.Price.Value.ToString("C") : L["Negotiable"].Value)</p>

        <p class="text-muted">
            @Model.Listing.Address<br />
            @Model.Listing.CityName, @Model.Listing.MunicipalityName, @Model.Listing.RegionName
        </p>

        <hr />

        <div class="row text-center mb-4">
            <div class="col">
                <div class="card search-card p-3">
                    <div class="fs-4 fw-bold" style="color: var(--primary-dark);">@Model.Listing.NumberOfBedrooms</div>
                    <div class="text-muted small">@L["Unit_Bedrooms"]</div>
                </div>
            </div>
            <div class="col">
                <div class="card search-card p-3">
                    <div class="fs-4 fw-bold" style="color: var(--primary-dark);">@Model.Listing.NumberOfBathrooms</div>
                    <div class="text-muted small">@L["Unit_Bathrooms"]</div>
                </div>
            </div>
            <div class="col">
                <div class="card search-card p-3">
                    <div class="fs-4 fw-bold" style="color: var(--primary-dark);">@Model.Listing.SquareFootage.ToString("N0")</div>
                    <div class="text-muted small">@L["Unit_SqM"]</div>
                </div>
            </div>
        </div>

        <hr />

        <h5 class="section-heading">@L["Details_Description"]</h5>
        <p>@Model.Listing.Description</p>

        <hr />

        <!-- Rating Section -->
        <div class="mb-4">
            <h5 class="section-heading">@L["Rating_Title"]</h5>
            @if (Model.RatingSummary.TotalRatings > 0)
            {
                <div class="d-flex align-items-center mb-2">
                    <span class="fs-4 fw-bold me-2">@Model.RatingSummary.AverageStars.ToString("0.0")</span>
                    <span class="stars-filled me-2">
                        @for (var s = 1; s <= 5; s++)
                        {
                            if (s <= Math.Round(Model.RatingSummary.AverageStars))
                            {
                                <span>&#9733;</span>
                            }
                            else
                            {
                                <span class="stars-empty">&#9734;</span>
                            }
                        }
                    </span>
                    <span class="text-muted">(@Model.RatingSummary.TotalRatings @L["Rating_Reviews"])</span>
                </div>
            }
            else
            {
                <p class="text-muted">@L["Rating_NoRatings"]</p>
            }

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="mt-2">
                    <span class="text-muted small mb-1 d-block">
                        @if (Model.RatingSummary.UserRating.HasValue)
                        {
                            @L["Rating_YourRating"]
                        }
                        else
                        {
                            @L["Rating_RateThis"]
                        }
                    </span>
                    <form method="post" asp-page-handler="Rate" asp-route-id="@Model.Listing.Id" class="d-inline">
                        @for (var s = 1; s <= 5; s++)
                        {
                            var starValue = s;
                            var isSelected = Model.RatingSummary.UserRating.HasValue && s <= Model.RatingSummary.UserRating.Value;
                            <button type="submit" name="stars" value="@starValue"
                                    class="btn btn-link p-0 fs-4 text-decoration-none @(isSelected ? "stars-filled" : "stars-empty")"
                                    title="@starValue">
                                @(isSelected ? "★" : "☆")
                            </button>
                        }
                    </form>
                </div>
            }
        </div>

        <hr />

        <dl class="row">
            <dt class="col-sm-3">@L["Field_Status"]</dt>
            <dd class="col-sm-9">
                @switch (Model.Listing.Status)
                {
                    case ListingStatus.PendingReview:
                        <span class="badge bg-warning text-dark">@L["Status_PendingReview"]</span>
                        break;
                    case ListingStatus.Active:
                        <span class="badge bg-success">@L["Status_Active"]</span>
                        break;
                    case ListingStatus.Rejected:
                        <span class="badge bg-danger">@L["Status_Rejected"]</span>
                        break;
                    case ListingStatus.Archived:
                        <span class="badge bg-secondary">@L["Status_Archived"]</span>
                        break;
                }
            </dd>

            @if (Model.Listing.Status == ListingStatus.Rejected && !string.IsNullOrWhiteSpace(Model.Listing.RejectionReason))
            {
                <dt class="col-sm-3">@L["Details_Reason"]</dt>
                <dd class="col-sm-9">
                    <div class="alert alert-danger mb-0 py-2">@Model.Listing.RejectionReason</div>
                </dd>
            }

            <dt class="col-sm-3">@L["Field_Listed"]</dt>
            <dd class="col-sm-9">@Model.Listing.CreatedAt.ToString("MMMM d, yyyy")</dd>

            @if (Model.Listing.UpdatedAt.HasValue)
            {
                <dt class="col-sm-3">@L["Field_Updated"]</dt>
                <dd class="col-sm-9">@Model.Listing.UpdatedAt.Value.ToString("MMMM d, yyyy")</dd>
            }
        </dl>
    </div>
</div>

<div class="mt-3">
    @if (User.IsAdmin() && Model.Listing.Status == ListingStatus.PendingReview)
    {
        <a asp-page="/Admin/ReviewListing" asp-route-id="@Model.Listing.Id" class="btn btn-primary">@L["Details_ReviewAsAdmin"]</a>
    }
    <a asp-page="Index" class="btn btn-secondary">@L["Details_BackToListings"]</a>
</div>
