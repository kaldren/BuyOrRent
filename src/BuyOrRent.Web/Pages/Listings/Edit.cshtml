@page "{id:guid}"
@model BuyOrRent.Web.Pages.Listings.EditModel
@{
    ViewData["Title"] = "Edit Listing";
}

<h1>Edit Listing</h1>

<div class="row">
    <div class="col-md-8">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Input.Id" />

            <div class="mb-3">
                <label asp-for="Input.Title" class="form-label"></label>
                <input asp-for="Input.Title" class="form-control" />
                <span asp-validation-for="Input.Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Description" class="form-label"></label>
                <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Input.Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Price" class="form-label"></label>
                <input asp-for="Input.Price" class="form-control" type="number" step="0.01" min="0" placeholder="Оставете празно за &quot;По договаряне&quot;" />
                <span asp-validation-for="Input.Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Images" class="form-label"></label>
                @if (Model.CurrentImageUrls.Any())
                {
                    <div class="row mb-2">
                        @foreach (var url in Model.CurrentImageUrls)
                        {
                            <div class="col-auto mb-2 text-center">
                                <img src="@url" alt="Listing image" class="img-thumbnail" style="max-height: 120px;" />
                                <div class="form-check mt-1">
                                    <input class="form-check-input" type="checkbox" name="RemoveImageUrls" value="@url" />
                                    <label class="form-check-label text-danger small">Remove</label>
                                </div>
                            </div>
                        }
                    </div>
                }
                <input name="Images" class="form-control" type="file" accept="image/*" multiple />
                <span class="text-muted small">По желание добавете нови снимки.</span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Address" class="form-label"></label>
                <input asp-for="Input.Address" class="form-control" />
                <span asp-validation-for="Input.Address" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Област</label>
                    <select asp-items="Model.Regions" class="form-select" id="regionSelect" data-selected-value="@Model.SelectedRegionId">
                        <option value="">-- Изберете област --</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Община</label>
                    <select class="form-select" id="municipalitySelect" data-selected-value="@Model.SelectedMunicipalityId">
                        <option value="">-- Изберете община --</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.CityId" class="form-label">Населено място</label>
                    <select asp-for="Input.CityId" class="form-select" id="citySelect" data-selected-value="@Model.SelectedCityId">
                        <option value="">-- Изберете населено място --</option>
                    </select>
                    <span asp-validation-for="Input.CityId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.NumberOfBedrooms" class="form-label"></label>
                    <input asp-for="Input.NumberOfBedrooms" class="form-control" type="number" />
                    <span asp-validation-for="Input.NumberOfBedrooms" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.NumberOfBathrooms" class="form-label"></label>
                    <input asp-for="Input.NumberOfBathrooms" class="form-control" type="number" />
                    <span asp-validation-for="Input.NumberOfBathrooms" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.SquareFootage" class="form-label"></label>
                    <input asp-for="Input.SquareFootage" class="form-control" type="number" step="0.1" />
                    <span asp-validation-for="Input.SquareFootage" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_LocationDropdownScriptsPartial" />
}
