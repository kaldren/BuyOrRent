@page
@using BuyOrRent.Modules.Listings.Domain.Enums
@model BuyOrRent.Web.Pages.Listings.IndexModel
@{
    ViewData["Title"] = L["Listings_Title"].Value;
}

<h1>@L["Listings_Title"]</h1>

@if (User.Identity?.IsAuthenticated == true)
{
    <p>
        <a asp-page="Create" class="btn btn-primary">@L["Listings_CreateNew"]</a>
    </p>
}

@if (!Model.Listings.Any())
{
    <div class="alert alert-info">@L["Listings_NoListings"]</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@L["Field_Title"]</th>
                <th>@L["Field_Location"]</th>
                <th>@L["Field_Price"]</th>
                <th>@L["Field_Bedrooms"]</th>
                <th>@L["Field_Bathrooms"]</th>
                <th>@L["Field_Status"]</th>
                <th>@L["Field_Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var listing in Model.Listings)
            {
                <tr>
                    <td><a asp-page="Details" asp-route-id="@listing.Id">@listing.Title</a></td>
                    <td>@listing.CityName, @listing.MunicipalityName</td>
                    <td>@(listing.Price.HasValue ? listing.Price.Value.ToString("C") : L["Negotiable"].Value)</td>
                    <td>@listing.NumberOfBedrooms</td>
                    <td>@listing.NumberOfBathrooms</td>
                    <td><span class="badge bg-success">@L["Status_Active"]</span></td>
                    <td>
                        @if (listing.SellerId == Model.CurrentUserId)
                        {
                            <a asp-page="Edit" asp-route-id="@listing.Id" class="btn btn-sm btn-outline-primary">@L["Action_Edit"]</a>
                            <a asp-page="Archive" asp-route-id="@listing.Id" class="btn btn-sm btn-outline-warning">@L["Action_Archive"]</a>
                            <a asp-page="Delete" asp-route-id="@listing.Id" class="btn btn-sm btn-outline-danger">@L["Action_Delete"]</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
