@page
@using global::Listings.Listing.Enums
@model BuyOrRent.Web.Pages.Listings.SearchModel
@{
    ViewData["Title"] = L["Search_Title"].Value;
}

<h1 class="section-heading">@L["Search_Title"]</h1>

<div class="card search-card mb-4">
    <div class="card-body">
        <form method="get">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">@L["Field_Region"]</label>
                    <select name="RegionId" class="form-select" id="regionSelect" data-selected-value="@Model.RegionId">
                        <option value="">@L["Filter_AllRegions"]</option>
                        @foreach (var region in Model.Regions)
                        {
                            <option value="@region.Value" selected="@(Model.RegionId?.ToString() == region.Value)">@region.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["Field_Municipality"]</label>
                    <select name="MunicipalityId" class="form-select" id="municipalitySelect" data-selected-value="@Model.MunicipalityId" data-placeholder="@L["Filter_AllMunicipalities"]">
                        <option value="">@L["Filter_AllMunicipalities"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["Field_City"]</label>
                    <select name="CityId" class="form-select" id="citySelect" data-selected-value="@Model.CityId" data-placeholder="@L["Filter_AllCities"]">
                        <option value="">@L["Filter_AllCities"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["Field_PropertyType"]</label>
                    <select name="SelectedPropertyType" class="form-select">
                        <option value="">@L["Filter_AllTypes"]</option>
                        @foreach (var pt in Model.PropertyTypeOptions)
                        {
                            <option value="@pt.Value" selected="@(Model.SelectedPropertyType?.ToString() == pt.Value)">@pt.Text</option>
                        }
                    </select>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    @L["Action_Search"]
                </button>
                <a asp-page="Search" class="btn btn-outline-secondary">@L["Action_Clear"]</a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Results.Any())
{
    <div class="alert alert-info">@L["Search_NoResults"]</div>
}
else
{
    <p class="text-muted mb-3">@L["Search_ResultsCount"]: @Model.Results.Count</p>
    <div class="row">
        @foreach (var listing in Model.Results)
        {
            <div class="col-md-4 mb-4">
                <a asp-page="Details" asp-route-id="@listing.Id" class="text-decoration-none text-reset">
                    <div class="card listing-card h-100">
                        @if (listing.ImageUrls.Any())
                        {
                            <img src="@listing.ImageUrls[0]" class="card-img-top" alt="@listing.Title" />
                        }
                        else
                        {
                            <div class="no-image-placeholder">
                                <span>@L["NoImage"]</span>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@listing.Title</h5>
                            <p class="card-text price">@(listing.Price.HasValue ? listing.Price.Value.ToString("C") : L["Negotiable"].Value)</p>
                            @{
                                Model.Ratings.TryGetValue(listing.Id, out var rating);
                            }
                            <p class="card-text">
                                <span class="stars-filled">
                                    @for (var s = 1; s <= 5; s++)
                                    {
                                        if (s <= Math.Round(rating.Average))
                                        {
                                            <span>&#9733;</span>
                                        }
                                        else
                                        {
                                            <span class="stars-empty">&#9734;</span>
                                        }
                                    }
                                </span>
                                <small class="text-muted">(@rating.Count)</small>
                            </p>
                            <p class="card-text text-muted">@listing.CityName, @listing.MunicipalityName</p>
                            <p class="card-text">
                                <span class="badge bg-info">@Model.GetPropertyTypeDisplayName(listing.PropertyType)</span>
                            </p>
                            <p class="card-text">
                                <small>@listing.NumberOfBedrooms @L["Unit_Bedrooms"] &middot; @listing.NumberOfBathrooms @L["Unit_Bathrooms"] &middot; @listing.SquareFootage @L["Unit_SqM"]</small>
                            </p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

@section Scripts {
    <partial name="_LocationDropdownScriptsPartial" />
}
