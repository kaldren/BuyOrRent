@using System.Security.Principal

<ul class="navbar-nav">
@if (User.Identity?.IsAuthenticated == true)
{
        <span class="navbar-text">
            @L["Auth_Hello"] @User.Identity?.Name!
            @if (User.IsAdmin())
            {
                <span class="badge admin-badge ms-1">@L["Auth_Admin"]</span>
            }
        </span>
        <li class="nav-item">
            <a class="nav-link" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignOut">@L["Auth_SignOut"]</a>
        </li>
}
else
{
        <li class="nav-item">
            <a class="btn btn-primary btn-sm ms-2" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignIn">@L["Auth_SignIn"]</a>
        </li>
}
</ul>
