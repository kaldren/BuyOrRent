<script>
    (function () {
        const regionSelect = document.getElementById('regionSelect');
        const municipalitySelect = document.getElementById('municipalitySelect');
        const citySelect = document.getElementById('citySelect');

        const munPlaceholder = municipalitySelect?.getAttribute('data-placeholder') || municipalitySelect?.options[0]?.text || '';
        const cityPlaceholder = citySelect?.getAttribute('data-placeholder') || citySelect?.options[0]?.text || '';

        function resetSelect(select, placeholder) {
            select.innerHTML = `<option value="">${placeholder}</option>`;
            select.disabled = true;
        }

        async function loadOptions(url, select, placeholder) {
            resetSelect(select, placeholder);
            const response = await fetch(url);
            if (!response.ok) return;
            const items = await response.json();
            items.forEach(item => {
                const option = document.createElement('option');
                option.value = item.id;
                option.textContent = item.name;
                select.appendChild(option);
            });
            select.disabled = false;
        }

        if (regionSelect) {
            regionSelect.addEventListener('change', function () {
                resetSelect(municipalitySelect, munPlaceholder);
                resetSelect(citySelect, cityPlaceholder);
                if (this.value) {
                    loadOptions(`/api/locations/municipalities/${this.value}`, municipalitySelect, munPlaceholder);
                }
            });
        }

        if (municipalitySelect) {
            municipalitySelect.addEventListener('change', function () {
                resetSelect(citySelect, cityPlaceholder);
                if (this.value) {
                    loadOptions(`/api/locations/cities/${this.value}`, citySelect, cityPlaceholder);
                }
            });
        }

        // Auto-trigger cascading load if values are pre-selected (edit scenario)
        const selectedRegion = regionSelect && (regionSelect.dataset.selectedValue || regionSelect.value);
        if (selectedRegion) {
            if (regionSelect.dataset.selectedValue) regionSelect.value = selectedRegion;
            loadOptions(`/api/locations/municipalities/${selectedRegion}`, municipalitySelect, munPlaceholder).then(() => {
                const selectedMun = municipalitySelect.dataset.selectedValue;
                if (selectedMun) {
                    municipalitySelect.value = selectedMun;
                    loadOptions(`/api/locations/cities/${selectedMun}`, citySelect, cityPlaceholder).then(() => {
                        const selectedCity = citySelect.dataset.selectedValue;
                        if (selectedCity) {
                            citySelect.value = selectedCity;
                        }
                    });
                }
            });
        }
    })();
</script>
